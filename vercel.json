{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/drafts/:path*",
      "destination": "/nerve",
      "permanent": false
    },
    {
      "source": "/nerve/terms",
      "destination": "/nerve/privacy",
      "permanent": false
    },
    {
      "source": "/HANDOFF.md",
      "destination": "/nerve",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "destination": "/nerve",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/nerve",
      "permanent": false
    },
    {
      "source": "/nerve/index.html",
      "destination": "/nerve",
      "permanent": true
    },
    {
      "source": "/nerve/download",
      "destination": "/nerve/downloads",
      "permanent": false
    },
    {
      "source": "/nerve/install",
      "destination": "/nerve/setup",
      "permanent": false
    },
    {
      "source": "/nerve/bugs",
      "destination": "/nerve/feedback",
      "permanent": false
    },
    {
      "source": "/nerve/changelog",
      "destination": "/nerve/releases",
      "permanent": false
    },
    {
      "source": "/nerve/support",
      "destination": "/nerve/feedback",
      "permanent": false
    },
    {
      "source": "/brushpass/index.html",
      "destination": "/brushpass",
      "permanent": true
    },
    {
      "source": "/brushpass/program.json",
      "destination": "/brushpass",
      "permanent": false
    },
    {
      "source": "/brush-pass/:path*",
      "destination": "/brushpass/:path*",
      "permanent": false
    },
    {
      "source": "/playtest",
      "destination": "/brushpass/playtest",
      "permanent": false
    },
    {
      "source": "/brushpass/(volunteer|signup|sign-up|test|testing|beta|alpha)",
      "destination": "/brushpass/playtest",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    }
  ]
}
